# Insights service configuration (OPS-01 §5.3). Placeholders only: never put a real value in git.
# Secrets are read only from files named by *_FILE variables (mounted from the host secret store).
ENV=dev
PUBLIC_BASE_URL=https://skills.example.internal

# Microsoft Entra ID (ADR 0002, SDD-07 §9). AUDIENCE is the truminds-insights-api application (client) ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
ENTRA_TSL_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_PORTAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_JWKS_FILE=/etc/truminds/jwks.json   # only for hosts without access to login.microsoftonline.com

# Identity provider (SDD-07 §1.4, ADR 0006): entra (default, production) or github (test phase only;
# refused when ENV=prod). The GitHub values are used only with IDENTITY_PROVIDER=github.
IDENTITY_PROVIDER=entra
# ENVIRONMENT=test shows the TEST ENVIRONMENT banner in the portal (alias of ENV above)
# ENVIRONMENT=test
GITHUB_CLIENT_ID=
# The OAuth App client secret: prefer the secret-store file; GITHUB_CLIENT_SECRET= also works
GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_URL=https://github.com
# Comma-separated GitHub logins that become admin on first sign-in (visible, logged, audited)
BOOTSTRAP_ADMIN_GITHUB_LOGINS=

# PostgreSQL 16 (sslmode verify-full in staging and prod, NFR-08)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=insights
DATABASE_SSLMODE=verify-full
DATABASE_CA_FILE=/etc/ssl/insights/db-ca.pem
DATABASE_OWNER_PASSWORD_FILE=/run/secrets/db_owner_password
DATABASE_APP_PASSWORD_FILE=/run/secrets/db_app_password
DATABASE_READ_PASSWORD_FILE=/run/secrets/db_read_password
DATABASE_REVEAL_PASSWORD_FILE=/run/secrets/db_reveal_password

# Secrets (SDD-08 §8.1, §9.2)
PSEUDONYM_PEPPER_FILE=/run/secrets/pepper
DATA_KEY_FILE=/run/secrets/data_key
DATA_KEY_ID=dk-1

# Catalogue (SDD-08 §6.4)
MARKETPLACE_REPO=example-org/skill-library
# CATALOGUE_SOURCE_DIR=/srv/catalogue   # checked-out release tree with a .release-tag file

# Retention (SDD-08 §8.2; OQ-08) and policy decisions (registry §11)
RETENTION_EVENTS_MONTHS=13
AUDIT_RETENTION_MONTHS=36
RD1_NAME_REVEAL_ROLES=eng_lead,admin
RD2_ENGINEER_RUN_SCOPE=system
RD3_QUESTION_TEXT_IN_CLOUD=false
RD5_FIRST_PASS_METRIC=first_try
RD6_WORKFLOW_NAMES=doc3

# Serving
SERVE_PORTAL=false
METRICS_PORT=9100
WORKER_METRICS_PORT=9101
