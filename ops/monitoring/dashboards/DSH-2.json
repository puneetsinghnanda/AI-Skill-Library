{
  "uid": "dsh-2",
  "title": "DSH-2 Ingest pipeline",
  "description": "OPS-02 \u00a79 DSH-2. Audience: On-call. No personal data.",
  "tags": [
    "truminds",
    "insights",
    "DSH-2"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "OPS-02",
      "url": "docs/operations/OPS-02-monitoring-alerting.md",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "Events received by type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (type) (rate(insights_events_received_total[5m]))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "title": "Events received by source",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (source) (rate(insights_events_received_total[5m]))",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "title": "Duplicates (R-05)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (source) (rate(insights_events_duplicate_total[5m]))",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "title": "Rejects by code (E-ING-01..05)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (code) (rate(insights_events_rejected_total[5m]))",
          "legendFormat": "{{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "title": "Events per batch (p50, p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(insights_batch_events_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(insights_batch_events_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "title": "Delivery delay (received_at - occurred_at)",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum by (le) (increase(insights_event_delivery_delay_seconds_bucket[10m]))",
          "legendFormat": "{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "title": "Projection lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(insights_projection_lag_seconds)",
          "legendFormat": "lag",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
