    {
      "title": "Projection backlog",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max(insights_projection_backlog_events)",
          "legendFormat": "backlog",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
