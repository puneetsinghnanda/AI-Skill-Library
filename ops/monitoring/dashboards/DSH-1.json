{
  "uid": "dsh-1",
  "title": "DSH-1 Service overview",
  "description": "OPS-02 \u00a79 DSH-1. Audience: On-call, Puneet. No personal data.",
  "tags": [
    "truminds",
    "insights",
    "DSH-1"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "OPS-02",
      "url": "docs/operations/OPS-02-monitoring-alerting.md",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "SLO-1 Ingest availability (30 d, target 99.5%)",
      "type": "stat",
      "targets": [
        {
          "expr": "1 - (sum(increase(insights_http_requests_total{route_group=\"ingest\",status_class=\"5xx\"}[30d])) / sum(increase(insights_http_requests_total{route_group=\"ingest\",status_class!=\"429\"}[30d])))",
          "legendFormat": "SLO-1",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "title": "SLO-2 Ingest latency <= 1 s (30 d, target 95%)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(insights_http_request_duration_seconds_bucket{route=\"/v1/events\",method=\"POST\",le=\"1\"}[30d])) / sum(increase(insights_http_request_duration_seconds_count{route=\"/v1/events\",method=\"POST\"}[30d]))",
          "legendFormat": "SLO-2",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 0
      },
