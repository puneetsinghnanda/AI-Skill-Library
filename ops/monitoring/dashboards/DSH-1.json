          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "title": "SLO-3 Projection freshness (30 d, target 99%)",
      "type": "stat",
      "targets": [
        {
          "expr": "avg_over_time((max(insights_projection_lag_seconds) <= bool 60)[30d:1m])",
