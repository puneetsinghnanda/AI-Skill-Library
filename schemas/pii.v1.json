{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/pii.v1.json",
  "title": "harness/rules/pii.v1.yaml (pii.v1)",
  "description": "H4b personal-data detector rule set shipped in tsl (SEC-01 §7.3): regex plus checksum validators, reserved ignores and context words. Hits report the rule id and line only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "pii.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pattern",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PII-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "pattern": {
            "type": "string",
            "format": "regex",
            "minLength": 1
          },
          "validator": {
            "enum": [
              "none",
              "luhn",
              "verhoeff",
              "mod97",
              "pan",
              "ipv4-public"
            ]
          },
          "ignore": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_window": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "enum": [
              "H4",
              "soft"
            ]
          }
        }
      },
      "minItems": 1
    }
  },
  "x-owner": "SDD-03 §4.6"
}
