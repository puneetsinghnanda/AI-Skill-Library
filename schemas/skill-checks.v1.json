{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/skill-checks.v1.json",
  "title": "checks.yaml (skill-checks.v1)",
  "description": "Code checks a skill's artifact must pass, selected from the tsl check library with parameters. Accepts the SDD-01 §9 library form (uses) and the SDD-03 §5.3 kind form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "skill-checks.v1"
    },
    "skill": {
      "$ref": "#/$defs/skill_id"
    },
    "artifact_schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "uses"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"
              },
              "uses": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z_]+$"
              },
              "gate": {
                "$ref": "#/$defs/hard_gate"
              },
              "soft": {
                "type": "boolean"
              },
              "with": {
                "type": "object"
              }
            },
            "description": "SDD-01 §9 form: a library check selected by name.",
            "oneOf": [
              {
                "required": [
                  "gate"
                ],
                "not": {
                  "required": [
                    "soft"
                  ]
                }
              },
              {
                "required": [
                  "soft"
                ],
                "not": {
                  "required": [
                    "gate"
                  ]
                },
                "properties": {
                  "soft": {
                    "const": true
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "lookup",
                  "no-clash",
                  "coverage",
                  "count-match",
                  "enum-file",
                  "regex",
                  "cites-required",
                  "container",
                  "diff-limit",
                  "named-in",
                  "values-named",
                  "values-in-code"
                ]
              },
              "gate": {
                "enum": [
                  "H2",
                  "H5",
                  "soft"
                ],
                "default": "soft"
              },
              "select": {
                "type": "string",
                "pattern": "^\\$"
              },
              "in": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "path"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/rel_path"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\$"
                  }
                }
              },
              "against": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "path"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/rel_path"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\$"
                  }
                }
              },
              "key": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unless": {
                "type": "object"
              },
              "each": {
                "type": "string",
                "pattern": "^\\$"
              },
              "each_input": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                ],
                "description": "coverage: name of the step input whose front matter `each` selects from (default: the artifact itself), or a list of names of which the first input the step has is used (e.g. [design, architecture]: a bound design whose file is missing fails; only a step without a design uses the architecture)."
              },
              "nonempty": {
                "type": "boolean",
                "description": "coverage: fail when `each` selects nothing, so an input with nothing to cover cannot pass."
              },
              "each_key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prefix",
                  "select"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "select": {
                    "type": "string",
                    "pattern": "^\\$"
                  },
                  "sep": {
                    "type": "string",
                    "default": "/"
                  }
                },
                "description": "coverage: turn each item into keys '<item.prefix><sep><value>' for every value `select` finds in the item (stories[] + acceptance_criteria[].id -> S-1/AC1)."
              },
              "covered_by": {
                "type": "string",
                "pattern": "^\\$"
              },
              "covered_by_input": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "coverage: name of the step input whose front matter `covered_by` selects from (default: the artifact itself)."
              },
              "covered_by_key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prefix",
                  "select"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "select": {
                    "type": "string",
                    "pattern": "^\\$"
                  },
                  "sep": {
                    "type": "string",
                    "default": "/"
                  }
                },
                "description": "coverage: like `each_key`, for the references (results[] + covers[] -> TP-1/S-1/AC1)."
              },
              "defer_on_blocking": {
                "type": "boolean",
                "description": "coverage: skip while the artifact asks a blocking question not yet answered in this run; tsl decide then returns NEEDS-INPUT and the check runs again after the answer."
              },
              "link": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "description": "enum-file: when `select` picks objects, the field whose value must be in the allowlist."
              },
              "tag": {
                "type": "string",
                "description": "enum-file: a field of each selected object that must equal the last word on its value's line in the allowlist (e.g. a WCAG criterion's level). Needs `value`."
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "count_files": {
                "$ref": "#/$defs/glob"
              },
              "where": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "must": {
                "type": "string",
                "format": "regex"
              },
              "must_not": {
                "type": "string",
                "format": "regex"
              },
              "profile_step": {
                "enum": [
                  "build",
                  "test",
                  "lint",
                  "sast",
                  "secrets",
                  "coverage"
                ]
              },
              "optional_input": {
                "type": "boolean",
                "description": "coverage, named-in, values-in-code: skip when the step has none of the `each_input` inputs (a defect run's unit-test has no stories) instead of failing."
              },
              "or_named_in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "coverage: an item named as a word in one of these level-2 body sections (e.g. Unknown, with its reason) counts as accounted for."
              },
              "sections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "named-in: level-2 body sections in which every item `each` (with `each_key`) selects must be named. A keyed item S-1/AC2 is named when AC2 follows S-1 in the same bullet (S-1 AC2, S-1: ... (AC2), S-1 AC1-AC3)."
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "after"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/rel_path"
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": "values-named: the value lists of `file` that follow the word `after` (\"Status is A, B, C or D\"; three values or more)."
              },
              "text": {
                "type": "string",
                "pattern": "^\\$",
                "description": "values-named: path, inside each `each` object, of the text that must name the values."
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "each"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "each": {
                    "type": "string",
                    "pattern": "^\\$"
                  },
                  "link": {
                    "type": "string",
                    "default": "trace"
                  },
                  "text": {
                    "type": "string",
                    "default": "statement"
                  }
                },
                "description": "values-named: only `each` objects whose `link` ids name an item of input `input` whose `text` names the word or a value count (stories whose REQ is about statuses)."
              },
              "items": {
                "type": "string",
                "pattern": "^\\$",
                "description": "values-in-code: path, inside each `each` object, of the items (with id and text) whose values the code must hold."
              },
              "named_in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "values-in-code: only items the artifact names in these level-2 body sections (default Tests)."
              },
              "files": {
                "type": "string",
                "format": "regex",
                "description": "values-in-code: regex over repo-relative paths of the files whose added lines are read (the step's tests)."
              }
            },
            "description": "SDD-03 §5.3 form: a check declared by kind."
          }
        ]
      },
      "minItems": 1
    }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hard_gate": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7"
      ]
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Relative POSIX path, no '..', no leading '/'."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    }
  },
  "x-owner": "SDD-01 §9"
}
