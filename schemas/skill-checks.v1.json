{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/skill-checks.v1.json",
  "title": "checks.yaml (skill-checks.v1)",
  "description": "Code checks a skill's artifact must pass, selected from the tsl check library with parameters. Accepts the SDD-01 §9 library form (uses) and the SDD-03 §5.3 kind form.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "skill-checks.v1"
    },
    "skill": {
      "$ref": "#/$defs/skill_id"
    },
    "artifact_schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "uses"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]{2,3}-C[0-9]{2}$"
              },
              "uses": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z_]+$"
              },
              "gate": {
                "$ref": "#/$defs/hard_gate"
              },
              "soft": {
                "type": "boolean"
              },
              "with": {
                "type": "object"
              }
            },
            "description": "SDD-01 §9 form: a library check selected by name.",
            "oneOf": [
              {
                "required": [
                  "gate"
                ],
                "not": {
                  "required": [
                    "soft"
                  ]
                }
              },
              {
                "required": [
                  "soft"
                ],
                "not": {
                  "required": [
                    "gate"
                  ]
                },
                "properties": {
                  "soft": {
                    "const": true
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"
              },
              "kind": {
                "enum": [
                  "lookup",
                  "no-clash",
                  "coverage",
                  "count-match",
                  "enum-file",
                  "regex",
                  "cites-required",
                  "container",
                  "diff-limit"
                ]
              },
              "gate": {
                "enum": [
                  "H2",
                  "H5",
                  "soft"
                ],
                "default": "soft"
              },
              "select": {
                "type": "string",
                "pattern": "^\\$"
              },
              "in": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "path"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/rel_path"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\$"
                  }
                }
              },
              "against": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "path"
                ],
                "properties": {
                  "file": {
                    "$ref": "#/$defs/rel_path"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\$"
                  }
                }
              },
              "key": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unless": {
                "type": "object"
              },
              "each": {
                "type": "string",
                "pattern": "^\\$"
              },
              "each_input": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "coverage: name of the step input whose front matter `each` selects from (default: the artifact itself)."
              },
              "each_key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prefix",
                  "select"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "select": {
                    "type": "string",
                    "pattern": "^\\$"
                  },
                  "sep": {
                    "type": "string",
                    "default": "/"
                  }
                },
                "description": "coverage: turn each item into keys '<item.prefix><sep><value>' for every value `select` finds in the item (stories[] + acceptance_criteria[].id -> S-1/AC1)."
              },
              "covered_by": {
                "type": "string",
                "pattern": "^\\$"
              },
              "link": {
                "type": "string"
              },
              "min": {
                "type": "integer",
                "minimum": 1
              },
              "count_files": {
                "$ref": "#/$defs/glob"
              },
              "where": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "must": {
                "type": "string",
                "format": "regex"
              },
              "must_not": {
                "type": "string",
                "format": "regex"
              },
              "profile_step": {
                "enum": [
                  "build",
                  "test",
                  "lint",
                  "sast",
                  "secrets",
                  "coverage"
                ]
              }
            },
            "description": "SDD-03 §5.3 form: a check declared by kind."
          }
        ]
      },
      "minItems": 1
    }
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "hard_gate": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7"
      ]
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Relative POSIX path, no '..', no leading '/'."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    }
  },
  "x-owner": "SDD-01 §9"
}
