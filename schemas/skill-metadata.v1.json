{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/skill-metadata.v1.json",
  "title": "skill.yaml (skill-metadata.v1)",
  "description": "Truminds manifest of one SDLC skill: identity, version, status, owner, inputs, outputs, limits, rubric, checks, evals and permitted tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "agent",
    "status",
    "owner",
    "inputs",
    "outputs",
    "rubric"
  ],
  "properties": {
    "schema": {
      "const": "skill-metadata.v1"
    },
    "id": {
      "$ref": "#/$defs/skill_id"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "agent": {
      "$ref": "#/$defs/agent_role"
    },
    "status": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "owner": {
      "$ref": "#/$defs/pseudonym"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "source": {
            "enum": [
              "artifact",
              "run",
              "context",
              "product",
              "mcp"
            ]
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
          },
          "path": {
            "$ref": "#/$defs/rel_path"
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "enum": [
                    "artifact",
                    "run"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "schema"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "enum": [
                    "context",
                    "product"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "path"
              ]
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.md$"
          },
          "kind": {
            "enum": [
              "artifact",
              "code"
            ],
            "default": "artifact"
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "code"
            }
          },
          "required": [
            "kind"
          ]
        },
        "else": {
          "required": [
            "schema",
            "file"
          ]
        }
      },
      "minItems": 1,
      "maxItems": 2
    },
    "context_sections": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9/._-]+(#[a-z0-9-]+)?$"
      }
    },
    "size_budget_tokens": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000
    },
    "rubric": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+\\.md$"
    },
    "checks": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+\\.ya?ml$"
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "min_cases",
        "min_pass_rate"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "min_cases": {
          "type": "integer",
          "minimum": 10
        },
        "min_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Read|Grep|Glob|Write|Edit|Bash\\([^()]+\\))$"
      },
      "uniqueItems": true
    },
    "change_limits": {
      "oneOf": [
        {
          "$ref": "#/$defs/change_limits"
        },
        {
          "type": "null"
        }
      ]
    },
    "deprecated_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/skill_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "string"
        },
        "trace_required": {
          "type": "boolean",
          "default": true
        },
        "trace_coverage": {
          "enum": [
            "full",
            "none"
          ]
        },
        "bands": {
          "$ref": "#/$defs/bands"
        }
      },
      "description": "Additive block from SDD-03 §5.3."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecated_by"
        ],
        "properties": {
          "deprecated_by": {
            "$ref": "#/$defs/skill_ref"
          }
        }
      }
    }
  ],
  "$defs": {
    "agent_role": {
      "enum": [
        "business-analyst",
        "solution-architect",
        "developer",
        "qa-engineer",
        "security",
        "devops",
        "ux-designer",
        "delivery-manager"
      ]
    },
    "band_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S1_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "S2_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "S3_min": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "S6_max_ratio": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-skill band thresholds; may only tighten the defaults (SDD-03 §10.2).",
      "properties": {
        "high": {
          "$ref": "#/$defs/band_thresholds"
        },
        "medium": {
          "$ref": "#/$defs/band_thresholds"
        }
      }
    },
    "change_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "sensitive_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          },
          "uniqueItems": true
        }
      }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "pilot",
        "production",
        "deprecated"
      ]
    },
    "phase": {
      "enum": [
        "requirements",
        "design",
        "build",
        "test",
        "operate"
      ]
    },
    "pseudonym": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{0,23}-[0-9a-f]{2,8}$",
      "maxLength": 32,
      "description": "Pseudonym such as eng-4f2a; never a real name."
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Relative POSIX path, no '..', no leading '/'."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "SemVer 2.0.0 without pre-release tags."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    },
    "skill_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Exact skill version, id@x.y.z."
    }
  },
  "x-owner": "SDD-01 §4"
}
