{
  "schema": "secrets.v1",
  "version": 1,
  "plugins": [
    {
      "name": "AWSKeyDetector"
    },
    {
      "name": "Base64HighEntropyString",
      "limit": 4.5
    }
  ],
  "entropy": {
    "min_length": 20,
    "min_bits_per_char": 4.0,
    "keyword_window": 40,
    "keywords": [
      "key",
      "secret",
      "token",
      "password"
    ]
  },
  "placeholders": [
    "<...>",
    "xxxx",
    "example",
    "changeme"
  ]
}
