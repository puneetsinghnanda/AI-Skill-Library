{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/eval-case.v1.json",
  "title": "evals/cases/<id>/case.yaml (eval-case.v1)",
  "description": "One eval case: invented input fixtures and code-checked expectations (outcome set, gate results, JMESPath assertions). provenance and attestation are required by SDD-11 GR-6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "inputs",
    "expect",
    "provenance",
    "attestation"
  ],
  "properties": {
    "schema": {
      "const": "eval-case.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^EC-[0-9]{2,3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "kind": {
      "enum": [
        "normal",
        "edge",
        "conflict",
        "adversarial",
        "forbidden-content"
      ]
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^inputs/(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_in"
      ],
      "properties": {
        "outcome_in": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "gates": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/hard_gate"
          },
          "additionalProperties": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "assert": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "count_min": {
                "type": "integer",
                "minimum": 0
              },
              "count_max": {
                "type": "integer",
                "minimum": 0
              },
              "any_matches": {
                "type": "string",
                "format": "regex"
              },
              "none_matches": {
                "type": "string",
                "format": "regex"
              },
              "equals": {}
            },
            "minProperties": 2
          }
        }
      }
    },
    "provenance": {
      "const": "invented"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "statement"
      ],
      "properties": {
        "by": {
          "$ref": "#/$defs/pseudonym"
        },
        "statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        }
      }
    }
  },
  "$defs": {
    "hard_gate": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7"
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "PASS-WITH-FINDINGS",
        "RETRY",
        "NEEDS-INPUT",
        "ESCALATE",
        "ABORT"
      ]
    },
    "pseudonym": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{0,23}-[0-9a-f]{2,8}$",
      "maxLength": 32,
      "description": "Pseudonym such as eng-4f2a; never a real name."
    }
  },
  "x-owner": "SDD-01 §10"
}
