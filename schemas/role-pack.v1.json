{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/role-pack.v1.json",
  "title": "plugins/truminds/role-packs/<role>/role-pack.yaml (role-pack.v1)",
  "description": "Role pack for one agent role: the skills the role owns, the rubric of each, and the role's default workflows. Pods reference it through agents[].role. Proposed (GAP-04); Puneet to confirm it is still wanted.",
  "x-status": "proposed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "title",
    "owner",
    "persona",
    "summary",
    "skills",
    "rubrics",
    "default_workflows"
  ],
  "properties": {
    "schema": {
      "const": "role-pack.v1"
    },
    "id": {
      "$ref": "#/$defs/agent_role"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "owner": {
      "$ref": "#/$defs/pseudonym"
    },
    "persona": {
      "type": "string",
      "pattern": "^P-0[1-8]$",
      "description": "Typical persona (Doc 2 §1, SDD-01 §11.1)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_range"
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    },
    "rubrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "path"
        ],
        "properties": {
          "skill": {
            "$ref": "#/$defs/skill_id"
          },
          "path": {
            "type": "string",
            "pattern": "^skills/[a-z][a-z0-9-]{2,39}/[A-Za-z0-9._-]+\\.md$",
            "description": "Rubric file relative to the plugin root (SDD-01 §8)."
          }
        }
      },
      "minItems": 1
    },
    "default_workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow_range"
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "deprecated_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecated_by"
        ],
        "properties": {
          "deprecated_by": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "agent_role": {
      "enum": [
        "business-analyst",
        "solution-architect",
        "developer",
        "qa-engineer",
        "security",
        "devops",
        "ux-designer",
        "delivery-manager"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "pilot",
        "production",
        "deprecated"
      ]
    },
    "pseudonym": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{0,23}-[0-9a-f]{2,8}$",
      "maxLength": 32,
      "description": "Pseudonym such as eng-4f2a; never a real name."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "SemVer 2.0.0 without pre-release tags."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    },
    "skill_range": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}@[\\^~]?\\d+(\\.\\d+){0,2}$",
      "description": "Skill id with a SemVer range, id@^1.2."
    },
    "workflow_range": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}@[\\^~]?\\d+(\\.\\d+){0,2}$"
    }
  },
  "x-owner": "SDD-01 §11.3"
}
