{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/eval-set.v1.json",
  "title": "evals/eval-set.yaml (eval-set.v1)",
  "description": "Header of a skill's eval set: minimum case count and pass rate, and the invented system the fixtures describe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill",
    "min_cases",
    "min_pass_rate",
    "fixture_system"
  ],
  "properties": {
    "schema": {
      "const": "eval-set.v1"
    },
    "skill": {
      "$ref": "#/$defs/skill_id"
    },
    "min_cases": {
      "type": "integer",
      "minimum": 10
    },
    "min_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fixture_system": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    }
  },
  "$defs": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    }
  },
  "x-owner": "SDD-01 §10"
}
