{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/pod.v1.json",
  "title": "pods/<id>/pod.yaml (pod.v1)",
  "description": "Pod definition: agents built from roles and skills, workflows, people and gates, business view and machine-checkable fit requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "title",
    "kind",
    "owner",
    "summary",
    "client_gets",
    "agents",
    "workflows",
    "people",
    "best_fit",
    "one_pager"
  ],
  "properties": {
    "schema": {
      "const": "pod.v1"
    },
    "id": {
      "$ref": "#/$defs/pod_id"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "$ref": "#/$defs/lifecycle_status"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "kind": {
      "enum": [
        "brownfield",
        "greenfield",
        "quality",
        "ux"
      ]
    },
    "owner": {
      "$ref": "#/$defs/pseudonym"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "client_gets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 1,
      "maxItems": 5
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "role",
          "display_name",
          "engineers",
          "job",
          "skills"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,15}$"
          },
          "role": {
            "$ref": "#/$defs/agent_role"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "engineers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "job": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/skill_range"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "cross_role_skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "reason"
              ],
              "properties": {
                "skill": {
                  "$ref": "#/$defs/skill_id"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow_range"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "kind",
          "duties"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "enum": [
              "platform",
              "external"
            ]
          },
          "platform_role": {
            "enum": [
              "tech_lead",
              "engineer",
              "eng_lead"
            ]
          },
          "duties": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "minItems": 1
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(G-[a-z0-9-]+|escalate)$"
            }
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "platform"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "required": [
            "platform_role"
          ]
        },
        "else": {
          "not": {
            "required": [
              "platform_role"
            ]
          }
        }
      },
      "minItems": 1,
      "contains": {
        "properties": {
          "platform_role": {
            "const": "tech_lead"
          }
        },
        "required": [
          "platform_role"
        ]
      }
    },
    "best_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "good_fit_when"
      ],
      "properties": {
        "good_fit_when": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 5
        },
        "not_a_fit_when": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 5
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_repo_host": {
              "enum": [
                "github"
              ]
            },
            "context_pack": {
              "enum": [
                "signed",
                "fresh",
                "none"
              ]
            },
            "docker": {
              "type": "boolean"
            },
            "figma_mcp": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "one_pager": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.md$"
    },
    "deprecated_by": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,35}-pod@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecated_by"
        ],
        "properties": {
          "deprecated_by": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "agent_role": {
      "enum": [
        "business-analyst",
        "solution-architect",
        "developer",
        "qa-engineer",
        "security",
        "devops",
        "ux-designer",
        "delivery-manager"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "pilot",
        "production",
        "deprecated"
      ]
    },
    "pod_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,35}-pod$"
    },
    "pseudonym": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{0,23}-[0-9a-f]{2,8}$",
      "maxLength": 32,
      "description": "Pseudonym such as eng-4f2a; never a real name."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "SemVer 2.0.0 without pre-release tags."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Skill id (SDD-01 §4)."
    },
    "skill_range": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}@[\\^~]?\\d+(\\.\\d+){0,2}$",
      "description": "Skill id with a SemVer range, id@^1.2."
    },
    "workflow_range": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,40}@[\\^~]?\\d+(\\.\\d+){0,2}$"
    }
  },
  "x-owner": "SDD-10 §3"
}
