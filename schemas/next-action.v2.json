{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/next-action.v2.json",
  "title": "tsl next instruction payload (next-action.v2)",
  "description": "The instruction tsl next returns in code mode: one action for the run skill loop (run_step, fix, run_reviewer, ask, pause_approval, done or stopped). Step actions carry the step, attempt, pinned skill, instruction file, artifact path, allowed tools, context, retry, budget and progress; fix carries the self-check items, run_reviewer the review package, ask the questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "run_id",
    "say"
  ],
  "properties": {
    "schema": {
      "const": "next-action.v2"
    },
    "action": {
      "enum": [
        "run_step",
        "fix",
        "run_reviewer",
        "ask",
        "pause_approval",
        "done",
        "stopped"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "say": {
      "type": "string",
      "description": "The one-line status shown to the person before the action."
    },
    "step": {
      "$ref": "#/$defs/step_id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "skill": {
      "$ref": "#/$defs/skill_ref"
    },
    "instruction_path": {
      "$ref": "#/$defs/rel_path"
    },
    "artifact_path": {
      "$ref": "#/$defs/rel_path"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "retry": {
      "oneOf": [
        {
          "$ref": "#/$defs/retry"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "fix": {
      "description": "The self-check items the step must fix before the full checks run (action fix).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/fix_item"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "ask": {
      "$ref": "#/$defs/ask"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "run_step",
              "fix",
              "run_reviewer"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "step",
          "attempt",
          "skill",
          "instruction_path",
          "artifact_path",
          "allowed_tools",
          "context",
          "retry",
          "budget",
          "progress"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "fix"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "fix"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "run_reviewer"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "ask"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "ask"
        ]
      }
    }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "context_sections",
        "answers",
        "open_questions"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "sha256",
              "schema"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/rel_path"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "schema": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
              }
            }
          }
        },
        "context_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answers": {
          "oneOf": [
            {
              "$ref": "#/$defs/rel_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/open_question"
          }
        }
      }
    },
    "open_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ask",
        "blocking",
        "question",
        "cite"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[0-9]{2,}$"
        },
        "ask": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "question": {
          "type": "string",
          "maxLength": 300
        },
        "cite": {
          "$ref": "#/$defs/rel_path"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "seeded_from",
        "feedback"
      ],
      "properties": {
        "cause": {
          "$ref": "#/$defs/attempt_cause"
        },
        "seeded_from": {
          "oneOf": [
            {
              "$ref": "#/$defs/rel_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "feedback": {
          "oneOf": [
            {
              "$ref": "#/$defs/rel_path"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fix_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_path",
        "write_to"
      ],
      "properties": {
        "package_path": {
          "$ref": "#/$defs/rel_path"
        },
        "write_to": {
          "$ref": "#/$defs/rel_path"
        }
      }
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions",
        "answers_to"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "blocking",
              "cite"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^Q-[0-9]{2,}$"
              },
              "question": {
                "type": "string",
                "maxLength": 300
              },
              "blocking": {
                "type": "boolean"
              },
              "cite": {
                "$ref": "#/$defs/rel_path"
              }
            }
          }
        },
        "answers_to": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "review",
        "verifier"
      ],
      "properties": {
        "checks": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "review": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "verifier": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "total"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "attempt_cause": {
      "enum": [
        "first",
        "retry_checks",
        "retry_review",
        "retry_verifier",
        "input_answered",
        "gate_changes",
        "gate_reject",
        "stale_rerun",
        "repin"
      ]
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Relative POSIX path, no '..', no leading '/'."
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Run id, run_<ULID> (Doc 5 §1.1)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256, lowercase hex (Doc 5 §1.1)."
    },
    "skill_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Exact skill version, id@x.y.z."
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$",
      "description": "Workflow step id (SDD-02 §3.2)."
    }
  },
  "x-owner": "Design A1 §5"
}
