{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/secrets.v1.json",
  "title": "harness/rules/secrets.v1.yaml (secrets.v1)",
  "description": "H4a secret detector rule set shipped in tsl: detect-secrets plugins with limits plus Truminds regex rules (SEC-01 §7.2). Hits report the rule id and line only, never the value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "secrets.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+$"
          },
          "limit": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "entropy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_length": {
          "type": "integer",
          "minimum": 8
        },
        "min_bits_per_char": {
          "type": "number",
          "minimum": 0
        },
        "keyword_window": {
          "type": "integer",
          "minimum": 0
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SEC-P-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "pattern": {
            "type": "string",
            "format": "regex",
            "minLength": 1
          },
          "exclude_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "minItems": 1
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-owner": "SDD-03 §4.6"
}
