{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/next-action.v1.json",
  "title": "tsl next data payload (next-action.v1)",
  "description": "The data object of tsl next --json: one action for the run skill loop, with the step, attempt, pinned skill, artifact path, resolved inputs, feedback, answers, budget and progress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "properties": {
    "schema": {
      "const": "next-action.v1"
    },
    "action": {
      "enum": [
        "run_skill",
        "run_decide",
        "pause_input",
        "pause_approval",
        "open_pr",
        "done",
        "stopped"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "step": {
      "$ref": "#/$defs/step_id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "cause": {
      "$ref": "#/$defs/attempt_cause"
    },
    "skill": {
      "$ref": "#/$defs/skill_ref"
    },
    "artifact_path": {
      "$ref": "#/$defs/rel_path"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256",
          "schema"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/rel_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "schema": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
          }
        }
      }
    },
    "feedback": {
      "oneOf": [
        {
          "$ref": "#/$defs/rel_path"
        },
        {
          "type": "null"
        }
      ]
    },
    "answers": {
      "oneOf": [
        {
          "$ref": "#/$defs/rel_path"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "review",
        "verifier"
      ],
      "properties": {
        "checks": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "review": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "verifier": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "total"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "run_skill",
              "run_decide"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "step",
          "attempt",
          "cause",
          "skill",
          "artifact_path",
          "inputs",
          "feedback",
          "answers"
        ]
      }
    }
  ],
  "$defs": {
    "attempt_cause": {
      "enum": [
        "first",
        "retry_checks",
        "retry_review",
        "retry_verifier",
        "input_answered",
        "gate_changes",
        "gate_reject",
        "stale_rerun",
        "repin"
      ]
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Relative POSIX path, no '..', no leading '/'."
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Run id, run_<ULID> (Doc 5 §1.1)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256, lowercase hex (Doc 5 §1.1)."
    },
    "skill_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Exact skill version, id@x.y.z."
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$",
      "description": "Workflow step id (SDD-02 §3.2)."
    }
  },
  "x-owner": "SDD-02 §6"
}
