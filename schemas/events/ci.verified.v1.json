{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/events/ci.verified.v1.json",
  "title": "Event body: ci.verified (schema_version 1)",
  "description": "Sent by tsl ci-verify with the CI ingest token (the only type that token may send). Closed object; every string is length-capped (TM-08).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "number",
    "result",
    "codes",
    "head_sha"
  ],
  "properties": {
    "repo": {
      "$ref": "#/$defs/repo_name"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error_code"
      },
      "uniqueItems": true
    },
    "head_sha": {
      "$ref": "#/$defs/git_sha"
    }
  },
  "$defs": {
    "error_code": {
      "type": "string",
      "pattern": "^E-[A-Z][A-Z0-9]{0,5}-[0-9]{2}$",
      "description": "Error code (registry §2)."
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-hex git commit or tree SHA."
    },
    "repo_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "Product repo short name from tsl.yaml."
    }
  },
  "x-owner": "SDD-08 §4.5"
}
