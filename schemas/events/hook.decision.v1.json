{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.truminds.internal/events/hook.decision.v1.json",
  "title": "Event body: hook.decision (schema_version 1)",
  "description": "Sent by every hook invocation. Closed object; every string is length-capped (TM-08).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hook",
    "decision",
    "code"
  ],
  "properties": {
    "hook": {
      "enum": [
        "session-start",
        "pre-tool",
        "pre-mcp",
        "post-write",
        "session-end"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "feedback"
      ]
    },
    "code": {
      "oneOf": [
        {
          "$ref": "#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool_kind": {
      "enum": [
        "write",
        "edit",
        "bash",
        "mcp_read",
        "mcp_write",
        "other"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "error_code": {
      "type": "string",
      "pattern": "^E-[A-Z][A-Z0-9]{0,5}-[0-9]{2}$",
      "description": "Error code (registry §2)."
    }
  },
  "x-owner": "SDD-08 §4.5"
}
