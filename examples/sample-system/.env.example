# Order Tracker local settings. Copy to .env only if you run the API outside Docker.
# Placeholders only. Never commit real values.

API_HOST=127.0.0.1
API_PORT=3000
ORDER_HISTORY_DEFAULT_DAYS=7

# Either a connection string without a password ...
DATABASE_URL=postgres://order_tracker@127.0.0.1:5433/order_tracker
# ... or libpq-style variables. The password is read from a file, never from this file.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=order_tracker
PGDATABASE=order_tracker
PGPASSWORD_FILE=/path/to/your/local/password-file

# Seed anchor: a fixed ISO timestamp (deterministic, default) or "now" for demos.
SEED_ANCHOR=2026-09-30T12:00:00Z
