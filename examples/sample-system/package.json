{
  "name": "order-tracker",
  "version": "1.4.2",
  "private": true,
  "description": "Order Tracker: Truminds-written brownfield sample system. Invented data only, no client code.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "db",
    "api",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "db:migrate": "npm run migrate -w db",
    "db:seed": "npm run seed -w db",
    "canary": "vitest run --config .answers/canary/vitest.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "~2.1.9"
  }
}
