# Portal build-time configuration (SDD-09 §3.2, §10). Copy to .env.development.local for local work.
# None of these are secrets: the SPA holds no secret. Values differ per environment (dev, staging, prod).

# Microsoft Entra ID: the portal SPA app registration "truminds-portal" (ADR 0002, SDD-09 §3.4)
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Redirect URI registered on the SPA app; defaults to <origin>/auth/callback when empty
VITE_ENTRA_REDIRECT_URI=
# Scope exposed by the API app "truminds-insights" (SDD-07 §9, SDD-08 §9.1)
VITE_API_SCOPE=api://truminds-insights/Portal.Read
# Write scope, requested incrementally and only on the admin screens (SDD-09 §4.16, SDD-07 §9)
VITE_API_WRITE_SCOPE=api://truminds-insights/Portal.Write

# Read API base. Empty means same origin (/v1 behind the intranet edge; no CORS).
VITE_API_BASE_URL=

# Links (OQ-10, SDD-10 §6.4)
VITE_MARKETPLACE_REPO_URL=https://github.com/[TRUMINDS-ORG]/truminds-skill-library
VITE_PILOT_MAILTO=ai-practice@example.invalid
VITE_HELP_URL=

# Shown in the footer
VITE_ENV_NAME=dev
VITE_BUILD_ID=local

# Open policy decisions (registry §11). The server enforces them; the portal only words its notes
# and toggles to match. Defaults are the registry recommendations.
# RD-1: roles that may reveal engineer names (comma list)
VITE_RD1_NAME_REVEAL_ROLES=eng_lead,admin
# RD-2: what runs an engineer sees: system | project
VITE_RD2_ENGINEER_RUN_SCOPE=system
# RD-3: question text in the cloud: false keeps links to open-questions.md only
VITE_RD3_QUESTION_TEXT_IN_CLOUD=false
