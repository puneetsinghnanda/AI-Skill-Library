{
  "name": "truminds-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Truminds AI Skill Library intranet portal (SDD-09). Read-only React SPA over the insights read API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite build --mode demo --outDir dist-demo && vite preview --mode demo --outDir dist-demo --port 4173 --strictPort",
    "demo:build": "vite build --mode demo --outDir dist-demo",
    "demo:serve": "vite preview --mode demo --outDir dist-demo --port 4173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "check:api": "node scripts/check-schema-drift.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:tokens && npm run check:api && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "^2.11.0",
    "openapi-typescript": "^7.9.0",
    "prettier": "^3.6.0",
    "stylelint": "^16.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
