#!/bin/sh
# tsl-hook <event>: thin launcher for the truminds plugin hooks (SDD-05 §5.2, §5.4; SDD-04 §6.14).
#
# Hot path (every tool call): shell builtins only, then runs `tsl hook-run <event> --plugin-root <dir>` once, so a
# hook costs ONE process start (each start costs 0.3-0.45 s under an EDR on Windows; the old launcher started about
# 15). stdin passes straight through; tsl's stdout is captured and printed only when tsl exits 0, so a dying or old
# tsl can never mix its own output with the fallback answer. Everything else runs inside tsl (tsl/hooks/entry.py):
#   - the version check: `tsl` must equal the plugin version (plugin.json), E-VER-01;
#   - the time budget (8 s pre-tool and pre-mcp, 12 s session hooks, 85 s post-write; TSL_HOOK_BUDGET_S can only
#     lower it), enforced by a watchdog, since this script no longer supervises tsl;
#   - SDD-05 §5.4 on a crash, overrun or version mismatch:
#        pre-tool, pre-mcp     inside a run: deny with E-HOOK-01 (fail closed); outside a run: allow (fail open)
#        post-write            allow, warn with systemMessage (fail open; never lose the engineer's work)
#        session-start/end     version mismatch: warn with systemMessage; crash or timeout: ignore, log
#
# Only "tsl is not installed" and "tsl died (non-zero exit)" are handled here, below, with the same rules (slow sed
# code, rare). One deliberate difference: session hooks warn (E-HOOK-01) when tsl died, because this script cannot
# tell a crash from an older tsl, and the warning carries the update command.
# "Inside a run" means a run lock file exists (registry §8: runs/active/<ticket>__<workflow>.lock), found either
# through this session's index ~/.truminds/sessions/<session_id>.json (SDD-04 §6.14) or by walking up from the
# hook's cwd to the companion repo root (the folder holding tsl.yaml). The walk is deliberately conservative: when
# tsl cannot decide, any active lock in this companion repo keeps writes closed.
#
# POSIX sh only (dash, bash, busybox ash, macOS sh, Git Bash on Windows). No jq, no coreutils `timeout`.
# There is no switch that turns any check off.

set -u

EVENT=${1:-}
case "$EVENT" in
  session-start|pre-tool|pre-mcp|post-write|session-end) ;;
  *) printf 'tsl-hook: unknown event "%s"\n' "$EVENT" >&2; exit 1 ;;
esac

# Plugin root for the version check, by parameter expansion only (no external command, no subshell). It goes to tsl
# as an argument, never through the environment, so an inherited variable cannot point the check elsewhere.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  R=$CLAUDE_PLUGIN_ROOT
else
  case "$0" in */*) R="${0%/*}/.." ;; *) R=".." ;; esac
fi

# tsl runs as a child (no exec) so the exit status is visible here. Its own fail rules always end in exit 0, even a
# deny, so any other status means tsl itself died (broken install, failed import). The fallback below then applies
# the same rules. hook-run is unknown to an older tsl, which exits non-zero, so a stale tsl in a run is denied.
FAILED=''
for c in tsl "${HOME:-}/.local/bin/tsl" "${HOME:-}/.local/share/uv/tools/truminds-tsl/bin/tsl"; do
  case "$c" in
    tsl) command -v tsl >/dev/null 2>&1 || continue ;;
    *) [ -x "$c" ] || continue ;;
  esac
  # A single command substitution forks once and execs tsl in that fork: the same cost as a plain child.
  OUT=$("$c" hook-run "$EVENT" --plugin-root "$R")
  rc=$?
  if [ "$rc" -eq 0 ]; then
    [ -z "$OUT" ] || printf '%s' "$OUT"
    exit 0
  fi
  FAILED="tsl hook $EVENT exited with status $rc (tsl crashed, failed to start, or is older than this plugin)"
  break
done

# ------------------------------------------------------------------------------- tsl is not installed (slow path)
PLUGIN_ROOT=$R
TRUMINDS_DIR="${HOME:-}/.truminds"
HOOK_LOG="$TRUMINDS_DIR/logs/hook.log"

IN=$(mktemp "${TMPDIR:-/tmp}/tsl-hook.XXXXXX" 2>/dev/null) || IN=/dev/null
trap '[ "$IN" = /dev/null ] || rm -f "$IN"' EXIT
trap 'exit 1' INT TERM HUP
cat > "$IN"

log_line() { # decision code detail
  mkdir -p "$TRUMINDS_DIR/logs" 2>/dev/null || return 0
  printf '%s tsl-hook event=%s decision=%s code=%s detail=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$EVENT" "$1" "$2" "$3" >> "$HOOK_LOG" 2>/dev/null || true
}

json_field() { # first string value of "key" in the stdin JSON (hook input is flat for the keys we need)
  sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$IN" 2>/dev/null | head -n 1
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

plugin_version() {
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PLUGIN_ROOT/.claude-plugin/plugin.json" 2>/dev/null | head -n 1
}

lock_exists_in() { # companion root
  for f in "$1"/runs/active/*.lock; do
    [ -f "$f" ] && return 0
  done
  return 1
}

run_active() {
  sid=$(json_field session_id)
  case "$sid" in
    ''|*[!A-Za-z0-9_.-]*) ;;
    *)
      idx="$TRUMINDS_DIR/sessions/$sid.json"
      if [ -f "$idx" ]; then
        comp=$(sed -n 's/.*"companion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$idx" | head -n 1)
        lock=$(sed -n 's/.*"lock"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$idx" | head -n 1)
        if [ -n "$comp" ] && [ -n "$lock" ] && [ -f "$comp/$lock" ]; then return 0; fi
      fi
      ;;
  esac
  dir=$(json_field cwd)
  [ -n "$dir" ] && [ -d "$dir" ] || dir=$PWD
  while [ -n "$dir" ]; do
    if [ -f "$dir/tsl.yaml" ]; then
      lock_exists_in "$dir" && return 0
      return 1
    fi
    parent=$(dirname -- "$dir")
    [ "$parent" = "$dir" ] && break
    dir=$parent
  done
  return 1
}

install_hint() { # no published package: tsl and the plugin both come from the library clone
  printf '%s' 'update tsl and the plugin from your AI-Skill-Library clone: git pull; uv tool install --python 3.12 --reinstall --no-cache ./tsl (TSL_ORG_FILE set, see docs/testing/team-setup-guide.md section 7a); claude plugin marketplace update truminds-skill-library; claude plugin update truminds@truminds-skill-library'
}

PV=$(plugin_version)
[ -n "$PV" ] || PV="unknown"
if [ -n "$FAILED" ]; then
  kind=crash
  detail="$FAILED. Install tsl $PV: $(install_hint)"
else
  kind=missing
  detail="tsl is not installed. Install tsl $PV: $(install_hint)"
fi

case "$EVENT" in
  pre-tool|pre-mcp)
    if run_active; then
      log_line deny E-HOOK-01 "$kind: $detail"
      r=$(json_escape "E-HOOK-01 Truminds run is active and the policy hook cannot run ($detail). Writes stay blocked until this is fixed.")
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$r"
    else
      log_line allow E-HOOK-01 "$kind (no active run): $detail"
    fi
    ;;
  post-write)
    log_line allow E-HOOK-01 "$kind (fail open): $detail"
    printf '{"systemMessage":"%s"}\n' "$(json_escape "Truminds: artifact checks did not run ($detail). Your file was kept. Fix tsl, then re-run the step's checks.")"
    ;;
  session-start|session-end)
    log_line warn E-HOOK-01 "$kind: $detail"
    printf '{"systemMessage":"%s"}\n' "$(json_escape "Truminds: $detail")"
    ;;
esac
exit 0
