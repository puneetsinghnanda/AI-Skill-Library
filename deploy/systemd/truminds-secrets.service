# Fetch secrets to tmpfs before the stack starts (OPS-01 §7.2). Install to /etc/systemd/system/.
[Unit]
Description=Truminds insights: fetch secrets from the host secret store
Wants=network-online.target
After=network-online.target
Before=truminds-insights.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/truminds/secrets.env
ExecStart=/opt/truminds/deploy/scripts/fetch-secrets.sh
ExecStop=/bin/umount /run/truminds-secrets

[Install]
WantedBy=multi-user.target
