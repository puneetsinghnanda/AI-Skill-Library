# pgBackRest repository location (OPS-01 §9). Non-secret values only; the real file is
# /etc/truminds/backup.env on the host. Storage keys and the cipher passphrase are Docker secrets.
# The store must be outside the VM, in the region chosen for OQ-03.
PGBACKREST_REPO1_S3_BUCKET=example-insights-backups
PGBACKREST_REPO1_S3_ENDPOINT=objectstore.example.internal
PGBACKREST_REPO1_S3_REGION=example-region-1
BACKUP_HOUR_UTC=02
FULL_WEEKDAY=7
