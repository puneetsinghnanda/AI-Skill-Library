# One-machine TEST environment (ADR 0006; deploy/README.md "Run the test environment on one machine
# for 6 testers"). Copy to deploy/compose/env/test.env (git-ignored) and fill in. Example values only.
ENVIRONMENT=test
# http://<host>:<port> as testers type it in the browser; the GitHub OAuth App callback is
# <PUBLIC_BASE_URL>/auth/github/callback
PUBLIC_BASE_URL=http://test-host.example.internal:8000

# GitHub sign-in (interim identity provider, test phase only)
IDENTITY_PROVIDER=github
GITHUB_CLIENT_ID=REPLACE-WITH-OAUTH-APP-CLIENT-ID
# The OAuth App client secret. This file is git-ignored; never commit the filled-in copy.
GITHUB_CLIENT_SECRET=REPLACE-WITH-OAUTH-APP-CLIENT-SECRET
GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_URL=https://github.com
# Your GitHub login: you get the admin role on first sign-in (logged at startup, audited)
BOOTSTRAP_ADMIN_GITHUB_LOGINS=your-github-login

# PostgreSQL in the same compose project, on an internal network only (no TLS inside the host)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=insights
DATABASE_SSLMODE=disable
DATABASE_OWNER_PASSWORD_FILE=/run/secrets/db_owner_password
DATABASE_APP_PASSWORD_FILE=/run/secrets/db_app_password
DATABASE_READ_PASSWORD_FILE=/run/secrets/db_read_password
DATABASE_REVEAL_PASSWORD_FILE=/run/secrets/db_reveal_password
PSEUDONYM_PEPPER_FILE=/run/secrets/pepper
DATA_KEY_FILE=/run/secrets/data_key
DATA_KEY_ID=dk-1

# Catalogue: the repository is mounted read-only at /srv/catalogue (compose.test.yml)
MARKETPLACE_REPO=example-org/skill-library

# Policy defaults until Puneet decides (registry §11)
RD1_NAME_REVEAL_ROLES=eng_lead,admin
RD2_ENGINEER_RUN_SCOPE=system
RD3_QUESTION_TEXT_IN_CLOUD=false
RD5_FIRST_PASS_METRIC=first_try
RD6_WORKFLOW_NAMES=doc3
SERVE_PORTAL=true
